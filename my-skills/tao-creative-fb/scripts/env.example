# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO SKILL: tao-creative-fb
# Sao chép file này thành .env và điền các khóa API thực tế của bạn
# =============================================================================

# 1. OPENAI API KEY (Dùng cho GPT-4o-mini viết copy và GPT Image model gpt-image-1)
OPENAI_API_KEY=your_openai_api_key_here

# 2. FACEBOOK GRAPH API (Dùng để đăng bài và ảnh lên Facebook Fanpage)
# Lấy từ Meta for Developers: Graph API Explorer hoặc Business Settings
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_TOKEN=your_facebook_page_token_here

# 3. CHẾ ĐỘ KIỂM THỬ (DRY_RUN)
# Đặt true: Không gọi Facebook API thật, lưu ảnh và copy ra local để kiểm tra
# Đặt false: Xuất bản trực tiếp lên Facebook Page
DRY_RUN=true
